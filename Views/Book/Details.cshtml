@model OnlineBookTracker.Models.BookDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5">
    <div class="card shadow-sm mx-auto border-0"
         style="max-width: 1000px;">

        <div class="card-body p-4 p-md-5">
            <div class="row g-4">

                <div class="col-md-4 text-center">
                    @if (!string.IsNullOrWhiteSpace(Model.CoverUrl))
                    {
                        <img src="@Model.CoverUrl"
                             alt="Cover of @Model.Title"
                             class="img-fluid rounded shadow-sm"
                             style="max-height: 420px; object-fit: contain;" />
                    }
                    else
                    {
                        <div class="bg-light border rounded p-5 text-muted">
                            <h5>No cover available</h5>
                            <p class="mb-0">Open Library has no cover image for this book.</p>
                        </div>
                    }
                </div>

                <div class="col-md-8">
                    <h1 class="mb-3">@Model.Title</h1>

                    <p class="text-muted mb-4">
                        Open Library work ID: @Model.OpenLibraryKey
                    </p>

                    <dl class="row">
                        <dt class="col-sm-4">Author</dt>
                        <dd class="col-sm-8">
                            @if (Model.Authors.Count > 0)
                            {
                                @string.Join(", ", Model.Authors)
                            }
                            else
                            {
                                <span>Unknown author</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Publication year</dt>
                        <dd class="col-sm-8">
                            @(Model.PublicationYear ?? "Not available")
                        </dd>

                        <dt class="col-sm-4">ISBN</dt>
                        <dd class="col-sm-8">
                            @if (Model.Isbns.Count > 0)
                            {
                                @string.Join(", ", Model.Isbns)
                            }
                            else
                            {
                                <span>Not available</span>
                            }
                        </dd>
                    </dl>

                    <hr />

                    <h4 class="mb-3">Description</h4>
                    <p style="white-space: pre-line;">@Model.Description</p>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <a class="btn btn-primary"
                           href="@Model.OpenLibraryUrl"
                           target="_blank"
                           rel="noopener noreferrer">
                            Open on Open Library
                        </a>

                        <a asp-controller="Book"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Back to Search
                        </a>
                    </div>

                    <div class="mt-4">
                        <form asp-controller="Library"
                            asp-action="Add"
                            method="post"
                            class="d-inline">

                            <input type="hidden"
                                name="id"
                                value="@Model.OpenLibraryKey" />

                            <button type="submit" class="btn btn-outline-primary">
                                Add to My Library
                            </button>
                        </form>


                        <a asp-controller="Review" asp-action="Index"
                        asp-route-id="@Model.OpenLibraryKey"
                        class="btn btn-outline-primary">
                            View Reviews
                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Review" asp-action="Create"
                            asp-route-id="@Model.OpenLibraryKey"
                            class="btn btn-primary">
                                Write a Review
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login"
                            class="btn btn-primary">
                                Log in to Review
                            </a>
                        }

                        <p class="small text-muted mt-2 mb-0">
                            Library and review actions will be enabled when those features are implemented.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>