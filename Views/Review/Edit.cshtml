
@model OnlineBookTracker.Models.ReviewFormViewModel

@{
    ViewData["Title"] = "Edit Review";
    int reviewId = ViewBag.ReviewId ?? 0;
}

<div class="container py-4" style="max-width: 700px;">
    <h2>Edit Review</h2>
    <h5 class="text-muted mb-4">@Model.BookTitle</h5>

    <form asp-action="Edit" asp-route-id="@reviewId" method="post">
        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <input asp-for="OpenLibraryKey" type="hidden" />
        <input asp-for="BookTitle" type="hidden" />

        <div class="mb-3">
            <label asp-for="Rating" class="form-label"></label>
            <select asp-for="Rating" class="form-select">
                @for (int i = 1; i <= 10; i++)
                {
                    <option value="@i">@i / 10</option>
                }
            </select>
            <span asp-validation-for="Rating"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ReviewText" class="form-label"></label>
            <textarea asp-for="ReviewText" class="form-control"
                      rows="6"></textarea>
            <span asp-validation-for="ReviewText"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-action="Index" asp-route-id="@Model.OpenLibraryKey"
           class="btn btn-outline-secondary">
            Cancel
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
