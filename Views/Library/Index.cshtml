@model List<OnlineBookTracker.Models.UserBook>

@{
    ViewData["Title"] = "My Library";
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between
                align-items-center mb-4 gap-2">
        <div>
            <h1>My Library</h1>
            <p class="text-muted mb-0">
                Manage your books and track your reading progress.
            </p>
        </div>

        <a asp-controller="Book"
           asp-action="Index"
           class="btn btn-primary">
            Find Books
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @success
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @error
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center p-5">
            <h3>Your library is empty</h3>
            <p class="text-muted">
                Search for a book and add it to your personal library.
            </p>
            <div>
                <a asp-controller="Book"
                   asp-action="Index"
                   class="btn btn-primary">
                    Search Books
                </a>
            </div>
        </div>
    }
    else
    {
        <p class="text-muted">
            Total books: @Model.Count
        </p>

        <div class="row g-4">
            @foreach (var book in Model)
            {
                <div class="col-sm-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm">

                        <div class="text-center bg-light p-3">
                            @if (book.CoverId.HasValue)
                            {
                                <img
                                    src="https://covers.openlibrary.org/b/id/@(book.CoverId)-M.jpg"
                                    alt="Cover of @book.BookTitle"
                                    class="img-fluid"
                                    style="height: 210px; max-width: 100%;
                                           object-fit: contain;" />
                            }
                            else
                            {
                                <div class="py-5 text-muted">
                                    No cover available
                                </div>
                            }
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@book.BookTitle</h5>

                            <p class="text-muted">
                                @(string.IsNullOrWhiteSpace(book.AuthorName)
                                    ? "Unknown author"
                                    : book.AuthorName)
                            </p>

                            <p class="small text-muted">
                                Added: @book.DateAdded.ToString("dd MMM yyyy")
                            </p>

                            <div class="mb-3">
                                <span class="badge bg-secondary">
                                    @book.ReadingStatus
                                </span>
                            </div>

                            <form asp-action="UpdateStatus"
                                  method="post"
                                  class="mt-auto">

                                <input type="hidden"
                                       name="id"
                                       value="@book.UserBookId" />

                                <label class="form-label"
                                       for="status-@book.UserBookId">
                                    Reading status
                                </label>

                                <select class="form-select mb-2"
                                        id="status-@book.UserBookId"
                                        name="status">
                                    <option value="Want to Read"
                                        selected="@(book.ReadingStatus == "Want to Read")">
                                        Want to Read
                                    </option>
                                    <option value="Reading"
                                        selected="@(book.ReadingStatus == "Reading")">
                                        Reading
                                    </option>
                                    <option value="Completed"
                                        selected="@(book.ReadingStatus == "Completed")">
                                        Completed
                                    </option>
                                </select>

                                <button type="submit"
                                        class="btn btn-outline-primary w-100">
                                    Update Status
                                </button>
                            </form>

                            <a href="https://openlibrary.org/works/@book.OpenLibraryKey"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-outline-secondary w-100 mt-2">
                                View Book Details
                            </a>

                            <form asp-action="Remove"
                                  method="post"
                                  class="mt-2"
                                  onsubmit="return confirm('Remove this book from your library?');">

                                <input type="hidden"
                                       name="id"
                                       value="@book.UserBookId" />

                                <button type="submit"
                                        class="btn btn-outline-danger w-100">
                                    Remove Book
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>